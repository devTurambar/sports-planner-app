# Default: normalize all text files to LF in the repo,
# check out as-is (LF) on all platforms.
* text=auto eol=lf

# Dart / Flutter source
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Android
*.gradle      text eol=lf
*.properties  text eol=lf
*.xml         text eol=lf
*.java        text eol=lf
*.kt          text eol=lf

# iOS / macOS
*.swift    text eol=lf
*.plist    text eol=lf
*.pbxproj  text eol=lf
*.xcconfig text eol=lf

# Shell scripts must be LF
*.sh text eol=lf

# Windows batch files stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.pdf  binary
*.zip  binary
*.jar  binary
*.so   binary
*.dylib binary
